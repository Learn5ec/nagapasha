# ============================================================
# nagapasha Configuration
# Copy this file to .env and set your values
# ============================================================

# --- LLM Configuration (Anthropic API) ---
# Anthropic API base URL (default: https://api.anthropic.com)
# For custom endpoints (e.g., Bedrock, Vertex), change this
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Anthropic API key (required)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_AUTH_TOKEN=

# Claude model to use (e.g., claude-sonnet-4-20250514, claude-opus-4-20250514)
# Leave empty to use default (claude-sonnet-4-20250514)
ANTHROPIC_MODEL=

# Temperature for generation (0.0 - 1.0, default: 0.7)
LLM_TEMPERATURE=0.7

# Top-p sampling (0.0 - 1.0, default: 0.9)
LLM_TOP_P=0.9

# Max tokens per response (default: 4096)
LLM_MAX_TOKENS=4096

# Per-invocation timeout in seconds (default: 120)
LLM_TIMEOUT=120

# Max retry attempts for LLM failures (default: 3)
LLM_RETRY_MAX=3

# --- Rate Limiting ---
# Default burst size (max concurrent requests)
DEFAULT_BURST=10

# Default refill rate (requests per second)
DEFAULT_REFILL_RATE=4.0

# --- Security ---
# SSL verification for generated scripts (true/false)
VERIFY_SSL=True

# --- Dashboard ---
# Dashboard port (default: 8000)
DASHBOARD_PORT=8000

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Knowledge Base ---
# Path to local KB directory (default: nagapasha/llm/kb)
KB_DIR=nagapasha/llm/kb

# Enable live KB search fallback (true/false)
KB_LIVE_SEARCH=false

# --- Output ---
# Default output format: json, markdown, sarif, junit, html, all
DEFAULT_OUTPUT_FORMAT=json

# Max total requests per run (default: 10000)
MAX_REQUESTS=10000

# --- MCP Web Search (Brave Search) ---
# Enable MCP web search for runtime payload sourcing
MCP_SEARCH_ENABLED=true
MCP_SEARCH_ENGINE=brave

# Brave Search API key (required for Brave Search MCP)
# Get your key from: https://brave.com/search/api/
BRAVE_API_KEY=

# Temporary download directory for MCP-fetched payloads
MCP_TEMP_DIR=nagapasha/llm/kb-temp

# Cleanup interval (seconds, default: 3600 = 1 hour)
MCP_CLEANUP_INTERVAL=3600

# Time-to-live for temp files (seconds, default: 86400 = 24 hours)
MCP_TTL=86400
